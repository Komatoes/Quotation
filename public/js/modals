// Handle stacking z-index when multiple modals are open
// Keep only z-index stacking logic here; cleanup is handled by modal-handler.js
document.addEventListener('show.bs.modal', function (event) {
    const openCount = document.querySelectorAll('.modal.show').length;
    if (openCount) {
        const zIndex = 1050 + (10 * openCount);
        event.target.style.zIndex = zIndex;
        // ensure the last backdrop sits below the modal
        setTimeout(() => {
            const modalBackdrop = document.querySelector('.modal-backdrop:last-of-type');
            if (modalBackdrop) modalBackdrop.style.zIndex = zIndex - 1;
        });
    }
});
